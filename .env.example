# OncoCare Environment Variables Configuration Example

# Gemini API Key for LLM integrations (Message generation, Report generation, Onco chatbot)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model name to use (defaults to gemini-3.6-flash)
GEMINI_MODEL_NAME=gemini-3.6-flash

# CORS Allowed Origins (comma-separated list for backend main.py)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
